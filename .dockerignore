# Ignore node_modules and other dependencies
/node_modules
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore build output directories
/build
/dist

# Ignore testing output directories
/coverage

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Ignore Docker-related files
Dockerfile
docker-compose.yml
.dockerignore

# Ignore editor-specific and IDE-related files
*.vscode/*
*.idea/*
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore miscellaneous system files
.DS_Store
Thumbs.db

# Ignore log files
/logs
*.log
*.log.*
